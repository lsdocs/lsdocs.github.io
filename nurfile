# Dev tasks for lsdocs.github.io (run with `nur`; `nur --list` shows them).

use scripts/org.nu
use scripts/org.nu run-cmd

# The `lsdocs` binary: LSDOCS_BIN if set, else lsdocs (default features:
# every built-in plugin) installed from git into target/lsdocs-bin. With
# LSDOCS_ORG_DIR set, from the local clones there.
def lsdocs-bin []: nothing -> string {
    let given = $env | get -o LSDOCS_BIN
    if $given != null and $given != "" { return $given }
    let root = $env.PWD | path join target lsdocs-bin
    with-env (org org-env) {
        run-cmd cargo install --quiet --git $"($org.ORG_URL)/lsdocs" --root $root lsdocs
    }
    $root | path join bin (if $nu.os-info.name == "windows" { "lsdocs.exe" } else { "lsdocs" })
}

# The download URL of schema.tar.gz on the newest `lsdocs-protocol/v*`
# release of the lsdocs-protocol repository (it also releases
# lsdocs-config, so its "latest" release may not be the one), or null.
def schema-archive-url []: nothing -> any {
    let token = $env | get -o GITHUB_TOKEN | default ($env | get -o GH_TOKEN)
    let headers = if $token != null and $token != "" { [Authorization $"Bearer ($token)"] } else { [] }
    let releases = (
        http get --headers $headers "https://api.github.com/repos/lsdocs/lsdocs-protocol/releases?per_page=100"
        | where {|r| ($r.tag_name | str starts-with "lsdocs-protocol/v") and not $r.draft }
        | sort-by created_at --reverse
    )
    if ($releases | is-empty) { return null }
    $releases | first | get assets | where name == "schema.tar.gz" | get -o 0.browser_download_url
}

# Copies lsdocs-protocol's JSON Schemas into `<out>/schema`: from its newest
# lsdocs-protocol release (schema.tar.gz), or, with LSDOCS_ORG_DIR set,
# from the local clone there.
def schemas [out: string]: nothing -> nothing {
    let dest = $out | path join schema
    rm -rf $dest
    let dir = $env | get -o LSDOCS_ORG_DIR
    if $dir != null and $dir != "" {
        cp -r ($dir | path join lsdocs-protocol schema) $dest
        return
    }
    let url = schema-archive-url
    if $url == null {
        error make --unspanned {msg: "no lsdocs-protocol release yet: release lsdocs-protocol there (or pass --no-schema)"}
    }
    let archive = "target/schema.tar.gz"
    mkdir target
    let got = http get --raw --full --allow-errors $url
    if $got.status != 200 {
        error make --unspanned {msg: $"downloading ($url) failed: ($got.status)"}
    }
    $got.body | save --raw --force $archive
    run-cmd tar -xzf $archive -C $out
}

# The newest `lsdocs-protocol/v*` tag of lsdocs-protocol (the release the
# schemas come from), or null. Read with git, so no API token is needed.
def protocol-tag []: nothing -> any {
    let url = $"($org.ORG_URL)/lsdocs-protocol"
    let refs = ^git ls-remote --tags --refs --sort=-v:refname $url "lsdocs-protocol/v*" | lines
    if ($refs | is-empty) { return null }
    $refs | first | split row "\t" | last | str replace "refs/tags/" ""
}

# The page of lsdocs-protocol's wire specification (`spec/wire.md`):
# docs/content/reference/wire.md, written for each build and not committed.
# From the newest lsdocs-protocol release's tag, or, with LSDOCS_ORG_DIR
# set, from the local clone there. Its links into that repository
# (`../schema/...`) are pointed at GitHub, at the same revision.
const WIRE_PAGE = "docs/content/reference/wire.md"
def wire-spec []: nothing -> nothing {
    let dir = $env | get -o LSDOCS_ORG_DIR
    let local = $dir != null and $dir != ""
    let rev = if $local { "main" } else { protocol-tag }
    if $rev == null {
        error make --unspanned {msg: "no lsdocs-protocol release yet: release lsdocs-protocol first"}
    }
    let text = if $local {
        open --raw ($dir | path join lsdocs-protocol spec wire.md)
    } else {
        let url = $"https://raw.githubusercontent.com/lsdocs/lsdocs-protocol/refs/tags/($rev)/spec/wire.md"
        let got = http get --raw --full --allow-errors $url
        if $got.status != 200 {
            error make --unspanned {msg: $"downloading ($url) failed: ($got.status)"}
        }
        $got.body
    }
    let base = $"($org.ORG_URL)/lsdocs-protocol/blob/($rev)/"
    let body = $text | str replace --all "\r\n" "\n" | str replace --all "](../" $"]\(($base)"
    $"---\ntitle: Wire protocol\nnav_order: 3\n---\n\n($body)" | save --raw --force $WIRE_PAGE
}

# Builds the site (lsdocs build) into `out` and fails on any warning or
# error, so broken links fail.
def build-site [out: string, --no-schema]: nothing -> nothing {
    wire-spec
    let result = with-env {LSDOCS_LOG: ""} {
        ^(lsdocs-bin) build --no-cache --config docs/lsdocs.toml --output-dir $out | complete
    }
    if $result.exit_code != 0 or ($result.stderr | str contains "warning") or ($result.stderr | str contains "error") {
        error make --unspanned {msg: $"the site should build cleanly:\n($result.stderr)"}
    }
    if not $no_schema { schemas $out }
    print $"built ($out)"
}

# Builds the site into docs/site, with the schemas under schema/ (pass
# --no-schema to skip them).
def "nur docs" [--no-schema] {
    build-site ("docs/site" | path expand) --no-schema=$no_schema
}

# What CI runs: the site builds without warnings (schemas are fetched when
# it is deployed).
def "nur ci" [] {
    build-site ("target/site" | path expand) --no-schema
}
