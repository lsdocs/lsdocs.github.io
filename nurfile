# Dev tasks for lsdocs.github.io (run with `nur`; `nur --list` shows them).

use scripts/org.nu

# The `lsdocs` binary: LSDOCS_BIN if set, else lsdocs (default features:
# every built-in plugin) installed from git into target/lsdocs-bin. With
# LSDOCS_ORG_DIR set, from the local clones there.
def lsdocs-bin []: nothing -> string {
    let given = $env | get -o LSDOCS_BIN
    if $given != null and $given != "" { return $given }
    let root = $env.PWD | path join target lsdocs-bin
    with-env (org org-env) {
        cargo install --quiet --git $"($org.ORG_URL)/lsdocs" --root $root lsdocs
    }
    $root | path join bin (if $nu.os-info.name == "windows" { "lsdocs.exe" } else { "lsdocs" })
}

# Copies lsdocs-protocol's JSON Schemas into `<out>/schema`: from its
# latest release (schema.tar.gz), or, with LSDOCS_ORG_DIR set, from the
# local clone there.
def schemas [out: string]: nothing -> nothing {
    let dest = $out | path join schema
    rm -rf $dest
    let dir = $env | get -o LSDOCS_ORG_DIR
    if $dir != null and $dir != "" {
        cp -r ($dir | path join lsdocs-protocol schema) $dest
        return
    }
    let archive = "target/schema.tar.gz"
    mkdir target
    let got = http get --raw --full --allow-errors $"($org.ORG_URL)/lsdocs-protocol/releases/latest/download/schema.tar.gz"
    if $got.status != 200 {
        error make --unspanned {msg: "no lsdocs-protocol release yet: push a v* tag there (or pass --no-schema)"}
    }
    $got.body | save --raw --force $archive
    tar -xzf $archive -C $out
}

# Builds the site (lsdocs build) into `out` and fails on any warning or
# error, so broken links fail.
def build-site [out: string, --no-schema]: nothing -> nothing {
    let result = with-env {LSDOCS_LOG: ""} {
        ^(lsdocs-bin) build --no-cache --config docs/lsdocs.toml --output-dir $out | complete
    }
    if $result.exit_code != 0 or ($result.stderr | str contains "warning") or ($result.stderr | str contains "error") {
        error make --unspanned {msg: $"the site should build cleanly:\n($result.stderr)"}
    }
    if not $no_schema { schemas $out }
    print $"built ($out)"
}

# Builds the site into docs/site, with the schemas under schema/ (pass
# --no-schema to skip them).
def "nur docs" [--no-schema] {
    build-site ("docs/site" | path expand) --no-schema=$no_schema
}

# What CI runs: the site builds without warnings (schemas are fetched when
# it is deployed).
def "nur ci" [] {
    build-site ("target/site" | path expand) --no-schema
}
